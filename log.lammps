# ============================================================
# STEP 4: Controlled loading
#
# 5000 steps = 5 ps
#
# sx/sy/sz specify final cell scale.
#
# Examples:
#
# Isotropic:
#   sx=0.99 sy=0.99 sz=0.99
#
# X loading:
#   sx=0.99 sy=1.00 sz=1.00
#
# Y loading:
#   sx=1.00 sy=0.99 sz=1.00
#
# Z loading:
#   sx=1.00 sy=1.00 sz=0.99
# ============================================================

reset_timestep 0

fix thermostat all nvt temp 300.0 300.0 0.1

fix compression all deform 1     x scale ${sx}     y scale ${sy}     z scale ${sz}     remap x
fix compression all deform 1     x scale 0.99     y scale ${sy}     z scale ${sz}     remap x
fix compression all deform 1     x scale 0.99     y scale 0.99     z scale ${sz}     remap x
fix compression all deform 1     x scale 0.99     y scale 0.99     z scale 0.99     remap x

# ------------------------------------------------------------
# Atomistic trajectory output
#
# Every 10 steps = 0.01 ps
#
# Includes:
#   ID
#   species
#   charge
#   unwrapped position
#   velocity
#   force
# ------------------------------------------------------------

dump trajectory all custom 10     traj_${runid}.lammpstrj     id type q xu yu zu vx vy vz fx fy fz
dump trajectory all custom 10     traj_test001.lammpstrj     id type q xu yu zu vx vy vz fx fy fz

dump_modify trajectory sort id

thermo 10

thermo_style custom     step     time     temp     pe     ke     etotal     enthalpy     vol     press     density

run 5000
