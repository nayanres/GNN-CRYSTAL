# ============================================================
# Anorthite production trajectory
# Matsui 1998 potential
#
# Material:
#   Ca8Al16Si16O64 = 8 CaAl2Si2O8
#
# Runtime parameters supplied by PowerShell:
#   seed   = thermal velocity seed
#   runid  = unique trajectory identifier
#   sx     = final x cell scale
#   sy     = final y cell scale
#   sz     = final z cell scale
#
# Example:
# lmp -var seed 10001 -var runid test001 \
#     -var sx 0.99 -var sy 0.99 -var sz 0.99 \
#     -in in.anorthite_production
# ============================================================

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task

# ------------------------------------------------------------
# Runtime parameters
# ------------------------------------------------------------

variable seed  index 492845
variable runid index test
variable sx    index 0.99
variable sy    index 0.99
variable sz    index 0.99

units metal
atom_style charge
boundary p p p

# ------------------------------------------------------------
# Read correctly remapped anorthite structure
#
# Type mapping:
#   1 = Ca
#   2 = Mg
#   3 = Al
#   4 = Si
#   5 = O
# ------------------------------------------------------------

read_data data.Anorthite.matsui
